<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= movie.title %> - FilmwebClone</title>
    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body class="bg-light">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">FilmwebClone</a>
            <div class="ms-auto">
                <% if (user) { %>
                    <span class="text-white me-3">Witaj, <a href="/user/menu" class="text-white text-decoration-none fw-bold"><%= user.username %></a>!</span>
                    <a href="/auth/logout" class="btn btn-outline-light btn-sm">Wyloguj</a>
                <% } else { %>
                    <a href="/login" class="btn btn-outline-light btn-sm me-2">Zaloguj</a>
                    <a href="/login" class="btn btn-primary btn-sm">Rejestracja</a>
                <% } %>
            </div>
        </div>
    </nav>

    <main class="container mb-5">
        <!-- Sekcja szczegółów filmu -->
        <div class="row bg-white p-4 rounded shadow-sm mb-4">
            <div class="col-md-8">
                <h1 class="fw-bold"><%= movie.title %></h1>
                <p class="text-muted">Reżyseria: <strong><%= movie.director %></strong></p>
                <hr>
                <p class="lead"><%= movie.description %></p>
            </div>
            <div class="col-md-4 text-center d-flex flex-column justify-content-center align-items-center bg-light rounded p-3">
                <h3 class="text-warning mb-0"><i class="bi bi-star-fill"></i> <%= movie.averageRating ? movie.averageRating.toFixed(1) : 'Brak' %></h3>
                <small class="text-muted">Średnia ocena</small>

                <!-- Formularz oceny filmu dla zalogowanych -->
                <% if (user) { %>
                    <form action="/movies/<%= movie.id %>/rate" method="POST" class="mt-3 w-100">
                        <div class="input-group input-group-sm">
                            <select name="value" class="form-select" required>
                                <option value="" selected disabled>Twoja ocena (1-10)</option>
                                <% for(let i = 1; i <= 10; i++) { %>
                                    <option value="<%= i %>" <%= userRating && userRating.value === i ? 'selected' : '' %>><%= i %> / 10</option>
                                <% } %>
                            </select>
                            <button class="btn btn-primary" type="submit"><%= userRating ? 'Zmień' : 'Oceń' %></button>
                        </div>
                    </form>
                <% } %>
            </div>
        </div>

        <!-- Sekcja komentarzy -->
        <div class="bg-white p-4 rounded shadow-sm">
            <h3 class="mb-4">Komentarze</h3>

            <!-- Formularz nowego głównego komentarza -->
            <% if (user) { %>
                <form action="/movies/<%= movie.id %>/comments" method="POST" class="mb-4">
                    <div class="mb-3">
                        <textarea name="content" class="form-control" rows="3" placeholder="Napisz co myślisz o tym filmie..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">Dodaj komentarz</button>
                </form>
            <% } else { %>
                <p class="text-muted"><a href="/login">Zaloguj się</a>, aby dodać komentarz lub ocenę.</p>
            <% } %>

            <hr>

            <!-- Lista komentarzy (główne + zagnieżdżone odpowiedzi) -->
            <% if (comments && comments.length > 0) { %>
                <% comments.forEach(comment => { %>
                    <div class="card mb-3 border-0 bg-light">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="card-subtitle mb-0 text-primary fw-bold"><%= comment.user ? comment.user.username : 'Nieznany' %></h6>
                                <small class="text-muted">
                                    <%= new Date(comment.createdAt).toLocaleDateString('pl-PL') %>
                                    <% if (comment.isEdited) { %>
                                        <span class="badge bg-secondary ms-1" style="font-size: 0.65rem;">edytowano</span>
                                    <% } %>
                                </small>
                            </div>

                            <!-- Treść komentarza -->
                            <p class="card-text mb-2"><%= comment.content %></p>

                            <!-- Przyciski akcji dla właściciela komentarza -->
                            <% if (user && user.id === comment.userId) { %>
                                <div class="mb-2 d-flex gap-2">
                                    <button class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.8rem;" onclick="toggleEditForm('<%= comment.id %>')">Edytuj</button>
                                    
                                    <form action="/comments/<%= comment.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Na pewno usunąć komentarz wraz z odpowiedziami?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 0.8rem;">Usuń</button>
                                    </form>
                                </div>

                                <!-- POPRAWIONY FORMULARZ EDYCJI: akcja wskazuje na /comments/:id/edit -->
                                <form action="/comments/<%= comment.id %>/edit" method="POST" id="edit-form-<%= comment.id %>" class="d-none mt-2">
                                    <div class="input-group input-group-sm mb-2">
                                        <input type="text" name="content" class="form-control" value="<%= comment.content %>" required>
                                        <button class="btn btn-success" type="submit">Zapisz</button>
                                        <button class="btn btn-outline-secondary" type="button" onclick="toggleEditForm('<%= comment.id %>')">Anuluj</button>
                                    </div>
                                </form>
                            <% } %>

                            <!-- Przycisk odpowiedzi -->
                            <% if (user) { %>
                                <button class="btn btn-link btn-sm p-0 text-decoration-none text-muted" style="font-size: 0.85rem;" onclick="toggleReplyForm('<%= comment.id %>')">
                                    <i class="bi bi-reply"></i> Odpowiedz
                                </button>

                                <!-- Formularz odpowiedzi -->
                                <form action="/movies/<%= movie.id %>/comments" method="POST" id="reply-form-<%= comment.id %>" class="d-none mt-2">
                                    <input type="hidden" name="parentId" value="<%= comment.id %>">
                                    <div class="input-group input-group-sm">
                                        <input type="text" name="content" class="form-control" placeholder="Napisz odpowiedź..." required>
                                        <button class="btn btn-outline-primary" type="submit">Wyślij</button>
                                    </div>
                                </form>
                            <% } %>

                            <!-- Zagnieżdżone odpowiedzi (Replies) -->
                            <% if (comment.replies && comment.replies.length > 0) { %>
                                <div class="ms-4 mt-3 border-start ps-3 border-2">
                                    <% comment.replies.forEach(reply => { %>
                                        <div class="card mb-2 bg-white border-0 shadow-sm">
                                            <div class="card-body py-2">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="text-primary fw-bold" style="font-size: 0.9rem;"><%= reply.user ? reply.user.username : 'Nieznany' %></span>
                                                    <small class="text-muted" style="font-size: 0.75rem;">
                                                        <%= new Date(reply.createdAt).toLocaleDateString('pl-PL') %>
                                                        <% if (reply.isEdited) { %>
                                                            <span class="badge bg-secondary ms-1" style="font-size: 0.6rem;">edytowano</span>
                                                        <% } %>
                                                    </small>
                                                </div>
                                                <p class="card-text mb-1" style="font-size: 0.9rem;"><%= reply.content %></p>

                                                <!-- Akcje dla odpowiedzi -->
                                                <% if (user && user.id === reply.userId) { %>
                                                    <div class="mb-1 d-flex gap-2">
                                                        <button class="btn btn-sm btn-outline-secondary py-0 px-1" style="font-size: 0.75rem;" onclick="toggleEditForm('<%= reply.id %>')">Edytuj</button>
                                                        
                                                        <form action="/comments/<%= reply.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Usunąć odpowiedź?');">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size: 0.75rem;">Usuń</button>
                                                        </form>
                                                    </div>

                                                    <!-- POPRAWIONY FORMULARZ EDYCJI ODPOWIEDZI -->
                                                    <form action="/comments/<%= reply.id %>/edit" method="POST" id="edit-form-<%= reply.id %>" class="d-none mt-2">
                                                        <div class="input-group input-group-sm mb-1">
                                                            <input type="text" name="content" class="form-control" value="<%= reply.content %>" required>
                                                            <button class="btn btn-success" type="submit">Zapisz</button>
                                                            <button class="btn btn-outline-secondary" type="button" onclick="toggleEditForm('<%= reply.id %>')">Anuluj</button>
                                                        </div>
                                                    </form>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } %>

                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p class="text-muted">Brak komentarzy. Bądź pierwszy!</p>
            <% } %>
        </div>
    </main>

    <!-- Skrypty JS do obsługi rozwijania formularzy edycji/odpowiedzi -->
    <script>
        function toggleEditForm(commentId) {
            const form = document.getElementById(`edit-form-${commentId}`);
            if (form) form.classList.toggle('d-none');
        }

        function toggleReplyForm(commentId) {
            const form = document.getElementById(`reply-form-${commentId}`);
            if (form) form.classList.toggle('d-none');
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
