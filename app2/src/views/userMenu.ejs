<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu Użytkownika - FilmwebClone</title>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="bg-light">

    <!-- Nawigacja / Pasek górny -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold text-warning" href="/">
                <i class="bi bi-film"></i> FilmwebClone
            </a>
            <div class="d-flex align-items-center">
                <a href="/" class="btn btn-outline-light me-2">
                    <i class="bi bi-house"></i> Strona główna
                </a>
                <a href="/auth/logout" class="btn btn-outline-danger">
                    <i class="bi bi-box-arrow-right"></i> Wyloguj się
                </a>
            </div>
        </div>
    </nav>

    <!-- Główna zawartość -->
    <main class="container my-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-7">

                <h2 class="mb-4 fw-bold"><i class="bi bi-person-gear"></i> Menu Użytkownika</h2>

                <!-- Komunikaty o błędach / sukcesie -->
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>
                <% if (typeof success !== 'undefined' && success) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <!-- Karta z informacjami o koncie -->
                <div class="card shadow-sm border-0 mb-4 rounded-4">
                    <div class="card-body p-4">
                        <h4 class="card-title mb-3 text-secondary"><i class="bi bi-info-circle"></i> Informacje o koncie</h4>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <span class="fw-semibold">Nazwa użytkownika:</span>
                                <span class="text-dark"><%= user.username %></span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <span class="fw-semibold">Adres e-mail:</span>
                                <span class="text-dark"><%= user.email %></span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Karta: Zmiana nazwy użytkownika -->
                <div class="card shadow-sm border-0 mb-4 rounded-4">
                    <div class="card-body p-4">
                        <h4 class="card-title mb-3 text-secondary"><i class="bi bi-pencil-square"></i> Zmień nazwę użytkownika</h4>
                        <form action="/user/update-username" method="POST">
                            <div class="mb-3">
                                <label for="newUsername" class="form-label">Nowa nazwa użytkownika</label>
                                <input type="text" class="form-control" id="newUsername" name="newUsername" required placeholder="Wpisz nową nazwę">
                            </div>
                            <button type="submit" class="btn btn-warning fw-semibold">Zaktualizuj nazwę</button>
                        </form>
                    </div>
                </div>

                <!-- Karta: Zmiana / Resetowanie hasła -->
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body p-4">
                        <h4 class="card-title mb-3 text-secondary"><i class="bi bi-key"></i> Zmiana hasła</h4>
                        <form action="/user/update-password" method="POST">
                            <div class="mb-3">
                                <label for="currentPassword" class="form-label">Obecne hasło</label>
                                <input type="password" class="form-control" id="currentPassword" name="currentPassword" required placeholder="••••••••">
                            </div>
                            <div class="mb-3">
                                <label for="newPassword" class="form-label">Nowe hasło</label>
                                <input type="password" class="form-control" id="newPassword" name="newPassword" required placeholder="••••••••">
                            </div>
                            <button type="submit" class="btn btn-dark fw-semibold">Zmień hasło</button>
                        </form>
                    </div>
                </div>

            </div>
</div>

<!-- Karta: Uwierzytelnianie dwuskładnikowe (2FA) -->
                <div class="card shadow-sm border-0 mb-4 rounded-4">
                    <div class="card-body p-4">
                        <h4 class="card-title mb-3 text-secondary"><i class="bi bi-shield-lock"></i> Uwierzytelnianie dwuskładnikowe (2FA)</h4>
                        
                        <% if (user.isTwoFactorEnabled) { %>
                            <div class="alert alert-success d-flex align-items-center mb-3" role="alert">
                                <i class="bi bi-shield-check me-2 fs-5"></i>
                                <div>2FA jest obecnie <strong>włączone</strong> i aktywne na Twoim koncie.</div>
                            </div>

                            <form action="/auth/2fa/disable" method="POST">
                                <div class="mb-3">
                                    <label for="disable2faPassword" class="form-label">Potwierdź obecnym hasłem, aby wyłączyć 2FA:</label>
                                    <input 
                                        type="password" 
                                        class="form-control" 
                                        id="disable2faPassword" 
                                        name="currentPassword" 
                                        placeholder="Wpisz swoje hasło" 
                                        required
                                    >
                                </div>
                                <button type="submit" class="btn btn-outline-danger fw-semibold" onclick="return confirm('Czy na pewno chcesz wyłączyć 2FA? Twoje konto będzie mniej bezpieczne.');">
                                    <i class="bi bi-shield-x"></i> Wyłącz 2FA
                                </button>
                            </form>
                        <% } else { %>
                            <p class="text-muted small mb-3">
                                Zabezpiecz swoje konto za pomocą aplikacji Google Authenticator. Przy każdym logowaniu wymagany będzie dodatkowy 6-cyfrowy kod.
                            </p>
                            <a href="/auth/2fa/setup" class="btn btn-warning fw-semibold">
                                <i class="bi bi-shield-plus"></i> Skonfiguruj i włącz 2FA
                            </a>
                        <% } %>
                    </div>
                </div>
<!-- Karta: Usuwanie konta -->
                <div class="card shadow-sm border-0 mt-4 rounded-4 border-danger">
                    <div class="card-body p-4">
                        <h4 class="card-title mb-3 text-danger"><i class="bi bi-exclamation-triangle"></i> Usuwanie konta</h4>
                        <p class="text-muted small">Tej operacji nie można cofnąć. Wszystkie Twoje dane i recenzje zostaną bezpowrotnie usunięte.</p>
                        <form action="/user/delete" method="POST" onsubmit="return confirm('Czy na pewno chcesz bezpowrotnie usunąć swoje konto?');">
                            <button type="submit" class="btn btn-danger fw-semibold">
                                <i class="bi bi-trash"></i> Usuń konto
                            </button>
                        </form>
                    </div>
                </div>
        </div>
    </main>

    <!-- Bootstrap 5 JS Bundle CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
