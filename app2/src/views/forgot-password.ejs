<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resetowanie hasła - FilmwebClone</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="bg-light d-flex align-items-center py-5" style="min-height: 100vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h3 class="card-title text-center mb-4 fw-bold">Resetowanie hasła</h3>

                        <% if (locals.error) { %>
                            <div class="alert alert-danger py-2"><%= error %></div>
                        <% } %>
                        <% if (locals.success) { %>
                            <div class="alert alert-success py-2"><%= success %></div>
                        <% } %>

                        <!-- Formularz 1: Generowanie tokenu na e-mail -->
                        <form action="/auth/forgot-password" method="POST" class="mb-4">
                            <label for="email" class="form-label fw-semibold">1. Poproś o link i token</label>
                            <div class="input-group mb-3">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input type="email" class="form-control" id="email" name="email" required placeholder="twoj@email.pl">
                            </div>
                            <button type="submit" class="btn btn-warning w-100 fw-bold py-2">Wygeneruj token</button>
                        </form>

                        <div class="d-flex align-items-center my-3">
                            <hr class="flex-grow-1 my-0">
                            <span class="px-3 text-muted small fw-semibold">ALBO</span>
                            <hr class="flex-grow-1 my-0">
                        </div>

                        <!-- Formularz 2: Wklejenie otrzymanego tokenu -->
                        <form action="/auth/enter-token" method="POST">
                            <label for="tokenInput" class="form-label fw-semibold">2. Masz już token? Wklej go tutaj</label>
                            <div class="input-group mb-3">
                                <span class="input-group-text"><i class="bi bi-key"></i></span>
                                <input type="text" class="form-control" id="tokenInput" name="token" required placeholder="Wklej otrzymany token...">
                            </div>
                            <button type="submit" class="btn btn-outline-dark w-100 fw-bold py-2">Przejdź do zmiany hasła</button>
                        </form>

                        <div class="mt-4 text-center">
                            <a href="/login" class="text-decoration-none small text-muted"><i class="bi bi-arrow-left"></i> Powrót do logowania</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
