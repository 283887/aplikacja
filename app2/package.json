{
  "name": "projekt-filmweb",
  "version": "1.0.0",
  "description": "Aplikacja webowa inspirowana filmwebem (SSR + Node.js + Express + PostgreSQL)",
  "main": "src/server.js",
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.9",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.22.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "start": "npx prisma db push --accept-data-loss && node src/server.js",
    "dev": "nodemon src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "npx prisma db seed",
    "db:push": "prisma db push"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
