<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= movie.title %> - FilmwebClone</title>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="bg-light">

    <!-- Nawigacja / Pasek górny -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold text-warning" href="/">
                <i class="bi bi-film"></i> FilmwebClone
            </a>
            <div class="d-flex align-items-center">
                <a href="/" class="btn btn-outline-light me-2">
                    <i class="bi bi-house"></i> Strona główna
                </a>
                <% if (typeof user !== 'undefined' && user) { %>
                    <div class="dropdown">
                        <a class="btn btn-outline-light dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i> <%= user.username %>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/user/menu">Menu użytkownika</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="/auth/logout">Wyloguj się</a></li>
                        </ul>
                    </div>
                <% } else { %>
                    <a href="/login" class="btn btn-warning fw-semibold">Zaloguj się</a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- Główna zawartość -->
    <main class="container my-5">
        
        <!-- Komunikaty -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <!-- Szczegóły filmu -->
        <div class="card shadow-sm border-0 mb-5 rounded-4 overflow-hidden">
            <div class="card-body p-4 p-md-5">
                <div class="row align-items-center">
                    <div class="col-md-9">
                        <h1 class="display-5 fw-bold text-dark mb-2"><%= movie.title %></h1>
                        <h4 class="text-muted mb-3"><i class="bi bi-camera-reels"></i> Reżyseria: <span class="text-secondary"><%= movie.director %></span></h4>
                        <p class="lead text-secondary"><%= movie.description %></p>
                    </div>
                    <div class="col-md-3 text-md-end mt-4 mt-md-0">
                        <div class="p-3 bg-light border rounded-4 d-inline-block text-center shadow-sm">
                            <span class="d-block text-muted small text-uppercase fw-bold">Średnia ocen</span>
                            <span class="fs-2 fw-bold text-warning">
                                <i class="bi bi-star-fill"></i> <%= movie.averageRating ? movie.averageRating.toFixed(1) : 'Brak' %>
                            </span>
                            <span class="d-block text-muted small">/ 10</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Sekcja komentarzy i recenzji -->
            <div class="col-lg-8">
                <h3 class="mb-4 fw-bold"><i class="bi bi-chat-left-text"></i> Oceny i komentarze</h3>

                <% if (typeof movie.reviews !== 'undefined' && movie.reviews.length > 0) { %>
                    <% movie.reviews.forEach(review => { %>
                        <div class="card shadow-sm border-0 mb-3 rounded-3">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-person-circle text-secondary"></i> <%= review.user.username %></h5>
                                    <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                                        <i class="bi bi-star-fill"></i> <%= review.rating %> / 10
                                    </span>
                                </div>
                                <p class="text-muted small mb-2"><%= new Date(review.createdAt).toLocaleDateString('pl-PL') %></p>
                                <p class="card-text mb-0"><%= review.comment %></p>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="alert alert-info">
                        Ten film nie ma jeszcze żadnych komentarzy. Bądź pierwszy i zostaw swoją opinię!
                    </div>
                <% } %>
            </div>

            <!-- Formularz dodawania oceny i komentarza -->
            <div class="col-lg-4 mt-4 mt-lg-0">
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body p-4">
                        <h4 class="card-title fw-bold mb-3"><i class="bi bi-star"></i> Oceń film</h4>
                        
                        <% if (typeof user !== 'undefined' && user) { %>
                            <form action="/movies/<%= movie.id %>/review" method="POST">
                                <div class="mb-3">
                                    <label for="rating" class="form-label">Twoja ocena (1-10)</label>
                                    <select class="form-select" id="rating" name="rating" required>
                                        <option value="" selected disabled>Wybierz ocenę</option>
                                        <% for(let i = 1; i <= 10; i++) { %>
                                            <option value="<%= i %>"><%= i %> <%= i === 1 ? 'punkt' : (i < 5 ? 'punkty' : 'punktów') %></option>
                                        <% } %>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="comment" class="form-label">Twój komentarz</label>
                                    <textarea class="form-control" id="comment" name="comment" rows="4" required placeholder="Napisz co sądzisz o tym filmie..."></textarea>
                                </div>
                                <button type="submit" class="btn btn-warning w-100 fw-bold py-2">Dodaj opinię</button>
                            </form>
                        <% } else { %>
                            <p class="text-muted">Musisz być zalogowany, aby móc ocenić film i dodać komentarz.</p>
                            <a href="/login" class="btn btn-outline-warning w-100 fw-semibold">Zaloguj się</a>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <!-- Bootstrap 5 JS Bundle CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
