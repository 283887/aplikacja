// Konfiguracja generatora klienta Prisimy
generator client {
  provider = "prisma-client-js"
}

// Konfiguracja połączenia z bazą PostgreSQL
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Tabela Użytkowników
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String   // Zaszyfrowane hasło
  profileImage  String?
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt DateTime @default(now())
  reviews   Review[] // Relacja do recenzji
  twoFactorSecret String?
  isTwoFactorEnabled Boolean @default(false)
}

// 2. Tabela Filmów
model Movie {
  id            Int      @id @default(autoincrement())
  title         String
  director      String
  description   String
  averageRating Float?   @default(0.0) // Średnia ocen
  reviews       Review[] // Relacja do recenzji
  createdAt     DateTime @default(now())
}

// 3. Tabela Ocen i Komentarzy (Łącząca użytkownika z filmem)
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int?     // Ocena opcjonalna (komentarz może być bez oceny, lub ocena tylko przy pierwszej recenzji)
  comment   String
  isEdited  Boolean  @default(false) // <-- Flaga informująca, czy komentarz był edytowany
  createdAt DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  movieId   Int
  movie     Movie    @relation(fields: [movieId], references: [id])

  // Obsługa odpowiedzi na komentarze (Self-relation)
  parentId  Int?
  parent    Review?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Review[] @relation("CommentReplies")

  @@unique([userId, movieId]) // <-- KLUCZOWE: Użytkownik może mieć tylko jeden wpis (ocenę/recenzję) dla danego filmu
}
