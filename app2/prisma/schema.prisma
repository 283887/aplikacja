// Konfiguracja generatora klienta Prisimy
generator client {
  provider = "prisma-client-js"
}

// Konfiguracja połączenia z bazą PostgreSQL
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int       @id @default(autoincrement())
  username           String    @unique
  email              String    @unique
  password           String
  profileImage       String?
  resetToken         String?   @unique
  resetTokenExpiry   DateTime?
  createdAt          DateTime  @default(now())
  
  ratings            Rating[]
  comments           Comment[]

  twoFactorSecret    String?
  isTwoFactorEnabled Boolean   @default(false)
}

model Movie {
  id            Int       @id @default(autoincrement())
  title         String
  director      String
  description   String
  averageRating Float?    @default(0.0)
  
  ratings       Rating[]
  comments      Comment[]
  
  createdAt     DateTime  @default(now())
}

// Osobna tabela na ocenę (1-10) - dokładnie jedna na użytkownika dla danego filmu
model Rating {
  id        Int      @id @default(autoincrement())
  value     Int      // Wartość oceny 1-10
  createdAt DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  movieId   Int
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId]) // Użytkownik może ocenić film tylko raz
}

// Tabela na komentarze oraz odpowiedzi (Self-relation) - użytkownik może dodać ich wiele
model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  movieId   Int
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  // Wątkowanie (odpowiedzi na komentarze)
  parentId  Int?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
}
