<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= movie.title %> - FilmwebClone</title>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="bg-light">

    <!-- Nawigacja -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold text-warning" href="/">
                <i class="bi bi-film"></i> FilmwebClone
            </a>
            <div class="d-flex align-items-center">
                <a href="/" class="btn btn-outline-light me-2">
                    <i class="bi bi-house"></i> Strona główna
                </a>
                <% if (user) { %>
                    <a href="/user/menu" class="btn btn-warning me-2">
                        <i class="bi bi-person-circle"></i> Menu użytkownika
                    </a>
                    <a href="/auth/logout" class="btn btn-outline-danger">Wyloguj</a>
                <% } else { %>
                    <a href="/login" class="btn btn-warning">Zaloguj się</a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- Główna zawartość -->
    <main class="container my-5">
        <div class="row justify-content-center">
            <div class="col-md-8">

                <!-- Szczegóły filmu -->
                <div class="card shadow-sm border-0 mb-4 rounded-4 p-4">
                    <h1 class="fw-bold mb-2"><%= movie.title %></h1>
                    <p class="text-muted mb-3">Reżyseria: <strong><%= movie.director %></strong> | Rok: <strong><%= movie.year %></strong></p>
                    <p class="mb-3"><%= movie.description %></p>
                    <div>
                        <span class="badge bg-warning text-dark fs-6 p-2">
                            <i class="bi bi-star-fill"></i> Średnia ocena: 
                            <%= movie.averageRating !== null ? movie.averageRating.toFixed(1) + ' / 10' : 'Brak ocen' %>
                        </span>
                    </div>
                </div>

                <!-- Sekcja dodawania recenzji -->
                <div class="card shadow-sm border-0 mb-4 rounded-4 p-4">
                    <h4 class="mb-3"><i class="bi bi-chat-square-text"></i> Dodaj recenzję</h4>
                    <% if (user) { %>
                        <form action="/movies/<%= movie.id %>/review" method="POST">
                            <div class="mb-3">
                                <label for="rating" class="form-label">Ocena (1-10)</label>
                                <select class="form-select" id="rating" name="rating" required>
                                    <option value="" disabled selected>Wybierz ocenę</option>
                                    <% for(let i = 1; i <= 10; i++) { %>
                                        <option value="<%= i %>"><%= i %> / 10</option>
                                    <% } %>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="comment" class="form-label">Komentarz</label>
                                <textarea class="form-control" id="comment" name="comment" rows="3" required placeholder="Napisz co sądzisz o tym filmie..."></textarea>
                            </div>
                            <button type="submit" class="btn btn-warning fw-semibold">Dodaj recenzję</button>
                        </form>
                    <% } else { %>
                        <p class="text-muted mb-0">Musisz być <a href="/login">zalogowany</a>, aby dodać recenzję.</p>
                    <% } %>
                </div>

                <!-- Lista recenzji -->
                <h3 class="mb-3">Recenzje użytkowników (<%= movie.reviews.length %>)</h3>
                <% if (movie.reviews.length === 0) { %>
                    <p class="text-muted">Ten film nie ma jeszcze żadnych recenzji. Bądź pierwszy!</p>
                <% } else { %>
                    <% movie.reviews.forEach(review => { %>
                        <div class="card shadow-sm border-0 mb-3 rounded-3">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-2">
                                    <!-- Awatar użytkownika w recenzji -->
                                    <% if (review.user && review.user.profileImage) { %>
                                        <img src="<%= review.user.profileImage %>" alt="Avatar" class="rounded-circle border me-2" style="width: 45px; height: 45px; object-fit: cover;">
                                    <% } else { %>
                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-2" style="width: 45px; height: 45px; font-size: 18px;">
                                            <i class="bi bi-person"></i>
                                        </div>
                                    <% } %>
                                    <div>
                                        <h6 class="mb-0 fw-bold"><%= review.user ? review.user.username : 'Nieznany użytkownik' %></h6>
                                        <small class="text-warning">
                                            <% for(let i = 1; i <= 10; i++) { %>
                                                <i class="bi bi-star<%= i <= review.rating ? '-fill' : '' %>"></i>
                                            <% } %>
                                            (<%= review.rating %>/10)
                                        </small>
                                    </div>
                                </div>
                                <p class="card-text mt-2 mb-0"><%= review.comment %></p>
                            </div>
                        </div>
                    <% }) %>
                <% } %>

            </div>
        </div>
    </main>

    <!-- Bootstrap 5 JS Bundle CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
