<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Filmweb Clone</title>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="bg-light">

    <!-- Nawigacja / Pasek górny -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">
            <!-- Logo -->
            <a class="navbar-brand fw-bold text-warning" href="/">
                <i class="bi bi-film"></i> FilmwebClone
            </a>

            <!-- Wyszukiwarka w nagłówku (Wymóg: pasek do wyszukiwania tytułów/reżyserów/aktorów) -->
            <form action="/" method="GET" class="d-flex mx-auto w-50">
                <input class="form-control me-2" type="search" name="search" placeholder="Szukaj filmu, reżysera, aktora..." value="<%= typeof searchTerm !== 'undefined' ? searchTerm : '' %>" aria-label="Szukaj">
                <button class="btn btn-outline-warning" type="submit"><i class="bi bi-search"></i></button>
            </form>

            <!-- Prawa strona: Logowanie / Menu użytkownika -->
            <div class="d-flex align-items-center">
                <% if (typeof user !== 'undefined' && user) { %>
                    <!-- Widok dla zalogowanego użytkownika -->
                    <div class="dropdown">
                        <a class="btn btn-outline-light dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i> <%= user.username %>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/user/menu">Menu użytkownika</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="/auth/logout">Wyloguj się</a></li>
                        </ul>
                    </div>
                <% } else { %>
                    <!-- Widok dla niezalogowanego użytkownika (Przycisk po prawej) -->
                    <a href="/login" class="btn btn-warning fw-semibold">
                        <i class="bi bi-box-arrow-in-right"></i> Zaloguj / Rejestracja
                    </a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- Główna zawartość strony -->
    <main class="container my-5">
        
        <% if (typeof searchTerm !== 'undefined' && searchTerm) { %>
            <h3 class="mb-4">Wyniki wyszukiwania dla: "<span class="text-primary"><%= searchTerm %></span>"</h3>
        <% } else { %>
            <h3 class="mb-4">Polecane filmy</h3>
        <% } %>

        <!-- Siatka z filmami -->
        <div class="row row-cols-1 row-cols-md-3 g-4">
            <% if (typeof movies !== 'undefined' && movies.length > 0) { %>
                <% movies.forEach(movie => { %>
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title fw-bold"><%= movie.title %></h5>
                                <h6 class="card-subtitle mb-2 text-muted">Reżyseria: <%= movie.director %></h6>
                                <p class="card-text"><%= movie.description %></p>
                            </div>
                            <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                                <span class="badge bg-warning text-dark fs-6">
                                    <i class="bi bi-star-fill"></i> <%= movie.averageRating ? movie.averageRating.toFixed(1) : 'Brak ocen' %>
                                </span>
                                <a href="/movies/<%= movie.id %>" class="btn btn-sm btn-outline-dark">Szczegóły i oceny</a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-12">
                    <div class="alert alert-info text-center" role="alert">
                        Brak filmów do wyświetlenia. Spróbuj wyszukać coś innego.
                    </div>
                </div>
            <% } %>
        </div>
    </main>

    <!-- Bootstrap 5 JS Bundle CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
